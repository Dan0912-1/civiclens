{
  "name": "capitolkey",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"PORT=3001 node --import ./instrument.js --env-file=.env api/server.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --import ./instrument.js --env-file=.env api/server.js",
    "start": "node --import ./instrument.js api/server.js",
    "cap:sync": "vite build && cap sync",
    "check:backend": "find api -type f -name '*.js' -not -path 'api/node_modules/*' -exec node --check {} +",
    "check:dupes": "node scripts/ci-duplicate-scan.mjs",
    "smoke:backend": "node scripts/ci-boot-smoke.mjs",
    "test:links": "node scripts/test-civic-links.mjs",
    "test:search": "node scripts/test-bill-search.mjs",
    "test:personalization": "node scripts/test-personalization-validation.mjs",
    "refresh:legislators": "node scripts/refresh-legislators.mjs",
    "check:sessions": "node scripts/check-session-freshness.mjs",
    "verify": "npm run check:backend && npm run check:dupes && npm run test:links && npm run test:search && npm run test:personalization && npm run check:sessions && npm run smoke:backend && npm run build",
    "postinstall": "bash scripts/patch-apple-signin.sh"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.9",
    "@fontsource/source-serif-4": "^5.2.9",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^10.49.0",
    "@sentry/react": "^10.47.0",
    "@supabase/supabase-js": "^2.100.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "posthog-js": "^1.393.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
